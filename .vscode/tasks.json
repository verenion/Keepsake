{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: app",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PhotoLibrary.App/PhotoLibrary.App.csproj",
                "-c", "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "build: app (release)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/PhotoLibrary.App/PhotoLibrary.App.csproj",
                "-c", "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "build: tests",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/tests/PhotoLibrary.Tests/PhotoLibrary.Tests.csproj",
                "-c", "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "build: solution",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/PhotoLibrary.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "test",
            "type": "process",
            "command": "dotnet",
            "args": ["test", "${workspaceFolder}/PhotoLibrary.slnx"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "test", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true }
        }
    ]
}
