<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App-wide look on top of Fluent: softer corners, calmer tabs, branded selection, gentle motion. -->

    <!-- Controls -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox, ComboBox">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="2,1" />
    </Style>

    <!-- Tabs: Fluent's 24px headers are made for phones; these read like a desktop app's navigation. -->
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="TabItem:not(:selected)">
        <Setter Property="Foreground" Value="{DynamicResource KsMutedBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.appbar">
        <Setter Property="Background" Value="{DynamicResource KsBarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KsBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.statusbar">
        <Setter Property="Background" Value="{DynamicResource KsBarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KsBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="14,5" />
    </Style>
    <Style Selector="Border.statusbar TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource KsMutedBrush}" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource KsCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource KsChipBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,1" />
    </Style>
    <Style Selector="Border.warn">
        <Setter Property="Background" Value="{DynamicResource KsWarnBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource KsBorderBrush}" />
    </Style>

    <!-- Type -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource KsMutedBrush}" />
    </Style>

    <!-- Photo tiles: rounded, a warm outline on hover, the accent when selected, all eased. -->
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource KsTileBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.tile:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource KsHoverBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.025)" />
    </Style>
    <Style Selector="Border.tile.selected, Border.tile.selected:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource KsSelectBrush}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
</Styles>
