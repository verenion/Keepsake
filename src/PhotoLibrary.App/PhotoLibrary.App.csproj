<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The .exe's own icon (Explorer, taskbar pins); the window icon comes from the same file. -->
    <ApplicationIcon>Assets\keepsake.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoLibrary.Core\PhotoLibrary.Core.csproj" />
    <ProjectReference Include="..\PhotoLibrary.AI\PhotoLibrary.AI.csproj" />
  </ItemGroup>
</Project>
