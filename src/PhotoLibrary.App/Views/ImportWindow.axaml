<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoLibrary.App.ViewModels"
        x:Class="PhotoLibrary.App.Views.ImportWindow"
        x:DataType="vm:ImportViewModel"
        Title="Import a folder" Width="1000" Height="720" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <!-- Folder row -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Check" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseClick" IsEnabled="{Binding !IsBusy}" Margin="8,0,0,0" />
            <TextBox Text="{Binding FolderPath}" Watermark="Folder to check (e.g. a Google Takeout export)" />
        </DockPanel>
        <CheckBox DockPanel.Dock="Top" Content="Only count byte-identical files as present (skip the visual-similarity check)" IsChecked="{Binding ExactOnly}" IsEnabled="{Binding !IsBusy}" Margin="0,0,0,8" />

        <!-- Status / progress -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding ProgressIndeterminate}" IsVisible="{Binding IsBusy}" Height="12" />
        </StackPanel>

        <!-- Bottom: import -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding ImportDone}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding ImportButtonText}" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" />
                <Button Content="Cancel" Click="CancelClick" IsVisible="{Binding IsBusy}" />
                <Button Content="Close" Click="CloseClick" IsEnabled="{Binding !IsBusy}" />
                <TextBlock Text="Originals are copied, never moved or changed." Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Results -->
        <ScrollViewer IsVisible="{Binding HasReport}">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding SummaryText}" FontFamily="Consolas, Menlo, monospace" />

                <TextBlock Text="{Binding SimilarHeader}" FontWeight="SemiBold" IsVisible="{Binding SimilarHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding Similar}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SimilarItemViewModel">
                            <Border BorderThickness="1" BorderBrush="{DynamicResource KsBorderBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,170,*,170,*">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Import this copy as well" />
                                    <Image Grid.Column="1" Source="{Binding NewThumb}" Width="160" Height="120" Stretch="Uniform" />
                                    <StackPanel Grid.Column="2" Margin="8,0" Spacing="2">
                                        <TextBlock Text="In this folder" Opacity="0.6" FontSize="11" />
                                        <TextBlock Text="{Binding NewName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NewDetails}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding How}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Image Grid.Column="3" Source="{Binding LibraryThumb}" Width="160" Height="120" Stretch="Uniform" />
                                    <StackPanel Grid.Column="4" Margin="8,0" Spacing="2">
                                        <TextBlock Text="Already in library" Opacity="0.6" FontSize="11" />
                                        <TextBlock Text="{Binding LibraryName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LibraryDetails}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding MissingHeader}" FontWeight="SemiBold" IsVisible="{Binding MissingHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding Missing}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MissingItemViewModel">
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
