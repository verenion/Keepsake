<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhotoLibrary.App.Views.PasswordWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="Password" />
        <TextBlock x:Name="Error" Foreground="#E5484D" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" IsCancel="True" Click="CancelClick" MinWidth="90" />
            <Button x:Name="OkButton" Classes="accent" Content="Unlock" IsDefault="True" Click="OkClick" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
