<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>

  <!-- Offline map data (see tools/geodata and THIRD_PARTY_NOTICES.md). WithCulture=false: otherwise MSBuild reads ".bin" as a language code and moves the files into a satellite assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Geo\Data\countries.bin.gz" LogicalName="PhotoLibrary.Core.Geo.Data.countries.bin.gz" WithCulture="false" />
    <EmbeddedResource Include="Geo\Data\places.bin.gz" LogicalName="PhotoLibrary.Core.Geo.Data.places.bin.gz" WithCulture="false" />
  </ItemGroup>

</Project>
